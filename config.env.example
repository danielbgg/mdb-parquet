# Copie para config.env e preencha. config.env está no .gitignore — nunca commite credenciais.
# Lido por common/config.py; variáveis de ambiente com o mesmo nome têm precedência.

# Cluster Atlas de destino (connection string SRV)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Federated Database Instance (Atlas Data Federation) com acesso ao bucket e ao cluster
ADF_URI=mongodb://<user>:<password>@<federated-instance>.a.query.mongodb.net/?ssl=true&authSource=admin

# Atlas
ATLAS_PROJECT_ID=<24-hex project id>
ATLAS_CLUSTER=<cluster-name>
ATLAS_TIER=M40                 # só para registro nos resultados

# S3 (bucket com input/, input_split/ e input_1m/)
S3_BUCKET=<bucket>
AWS_REGION=us-east-1
# AWS_PROFILE=<profile>        # opcional, para scripts/upload_s3.sh; senão usa AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY

# Bancos
TARGET_DB=ratings_poc          # banco de destino no cluster
ADF_DB=dbimport                # banco virtual no ADF (00_setup/adf_storage_config.json)
